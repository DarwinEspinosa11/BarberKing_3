# ── Base de datos ──────────────────────────────────
DB_HOST=localhost
DB_USER=tu_usuario_mysql
DB_PASSWORD=tu_contraseña_mysql
DB_NAME=barberia3_db

# ── Flask ──────────────────────────────────────────
# Genera un valor aleatorio: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-un-valor-aleatorio-seguro

# ── Entorno ────────────────────────────────────────
# Usa "production" en servidor real para activar cookies Secure
FLASK_ENV=development

# ── Admin ──────────────────────────────────────────
ADMIN_USER=admin
# Genera el hash con: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('tu_password'))"
ADMIN_PASSWORD_HASH=

# ── CORS ───────────────────────────────────────────
CORS_ORIGINS=http://localhost:5001
